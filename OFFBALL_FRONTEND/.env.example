# URL base de OFFBALL API (sin barra final).
# Modo directo (por defecto): el navegador llama a la API en el puerto 8000.
# El backend debe permitir el origen http://localhost:5173 (OFFBALL_ORIGINS).
VITE_API_BASE_URL=http://localhost:8000

# Modo proxy de desarrollo (mismo origen, sin CORS):
#   VITE_API_BASE_URL=
#   VITE_DEV_PROXY_TARGET=http://localhost:8000
VITE_DEV_PROXY_TARGET=

# Tiempo máximo por petición, en milisegundos.
VITE_API_TIMEOUT_MS=20000
